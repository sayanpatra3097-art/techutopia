generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(uuid())
  name                String?
  email               String        @unique
  password            String
  mustChangePassword  Boolean       @default(false)
  phone               String?
  college             String?
  referralCode        String        @unique
  referralPoints      Int           @default(0)
  referredById        String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  status              String        @default("ACTIVE")
  resetTokenExpiresAt DateTime?
  resetTokenHash      String?
  referralLogs        ReferralLog[] @relation("UserReferralLogs")
  referredBy          User?         @relation("UserReferrals", fields: [referredById], references: [id])
  invitedUsers        User[]        @relation("UserReferrals")
  emailSelection      AdminEmailSelection?
  emailSendRecords    EmailSendRecord[]

  @@index([referralCode])
  @@index([email])
}

model ReferralLog {
  id             String   @id @default(uuid())
  referrerId     String
  referredUserId String
  referredEmail  String
  bonusAwarded   Int      @default(1)
  createdAt      DateTime @default(now())
  referrer       User     @relation("UserReferralLogs", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}

model AdminEmailSelection {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmailSendRecord {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientEmail String
  emailType      String
  status         String   @default("NOT_SENT")
  resendEmailId  String?
  adminId        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  pendingAt      DateTime?
  completedAt    DateTime?
  rejectedAt     DateTime?
  errorMessage   String?

  @@index([userId])
}
